# Peoplebot-Megabot OS Installer Tools - Environment Configuration
# Copy this file to .env and modify values for your setup

# TFTP Server Base Directory (absolute path)
TFTP_DIR="/path/to/your/tftp/directory"

# ISO Directory Name (relative to TFTP_DIR)
ISO_DIR_NAME="isos"

# Extracted Content Directory Name (relative to TFTP_DIR)
EXTRACT_DIR_NAME="extracted"

# PXE Configuration Directory Name (relative to TFTP_DIR)
CFG_DIR_NAME="pxelinux.cfg"

# Default PXE Menu Filename
CFG_FILE_NAME="default"

# UEFI Boot File Download URLs
# These URLs are used by isolisting.py to download necessary UEFI boot files
UEFI_IPXE_URL="https://example.com/ipxe/package"
UEFI_SHIM_URL="https://example.com/shim/package"
UEFI_GRUB_URL="https://example.com/grub/package"

# PXE Network Configuration
# Network interface for dnsmasq (check with: ip link)
# Gunakan nama interface yang sesuai dengan sistem operasi:
# - Linux: lihat dengan `ip link` (contoh: enp45s0, eth0)
# - Windows/WSL: lihat dengan `wsl -d distro-name ip link` atau `get-NetIPAddress`
PXE_INTERFACE="your-network-interface"

# PXE Server IP Address (must match dnsmasq --bind-interfaces)
PXE_SERVER_IP="192.168.x.x"

# DHCP IP Range
PXE_DHCP_START="192.168.x.100"
PXE_DHCP_END="192.168.x.200"

# dnsmasq Service Mode
# "full"     = dnsmasq is the DHCP server (allocates IPs from PXE_DHCP_START/END)
#              and also provides PXE boot files via TFTP
# "pxe_only" = dnsmasq runs as a proxyDHCP server: an EXTERNAL DHCP server
#              assigns IPs and gateway, while dnsmasq only sends the PXE boot
#              filename and serves the boot files via TFTP. The proxy subnet
#              is derived automatically from PXE_SERVER_IP (e.g. 192.168.1.x/24)
# Leave empty or set to "auto" to use default behavior (full DHCP)
PXE_DHCP_MODE="full"

# DHCP Lease Time (only used when PXE_DHCP_MODE="full")
# Set the lease time for DHCP clients (e.g. "12h", "24h", "48h", "72h", "168h" for 1 week)
# This value is appended to the --dhcp-range option in dnsmasq
PXE_DHCP_LEASE_TIME="12h"

# HTTP Port for SquashFS File Streaming
PXE_HTTP_PORT="8080"

# Maximum ISO Size for Memdisk Boot (in MB)
# ISOs larger than this will be extracted for Low-RAM mode
PXE_MAX_MEMDISK_MB="300"

# Bundled dnsmasq binary path (statically linked, no host install required)
# Leave empty to use the bundled ./dnsmasq in the project folder
# Set to a system path like "/usr/bin/dnsmasq" to override
DNSMASQ_BIN=""

# dnsmasq source URL (used to auto-build the bundled binary if missing)
DNSMASQ_SRC_URL="https://example.com/dnsmasq/source"
